{
  "name": "ks-streamdeck",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate": "streamdeck validate com.kyuubisoft.fivem.sdPlugin",
    "pack": "npm run build && streamdeck pack com.kyuubisoft.fivem.sdPlugin --output ../dist --force --no-file-list",
    "pretest": "npm run build",
    "test:browser": "node tests/browser.mjs",
    "release": "node scripts/package.mjs",
    "test:lua": "cd .. && lua resources/ks_streamdeck/tests/run.lua && lua resources/ks_streamdeck/tests/adapters.lua && lua resources/ks_streamdeck/tests/framework.lua"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.19.11",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
